# =============================================================================
# AI for E-Commerce — Backend environment template
# Copy to `backend/.env` and fill in real values. NEVER commit `.env` (INV-01).
# All variables are optional for the offline test suite (INV-07).
# =============================================================================

# ----- General ---------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# ----- Phase 1: Marketplace search & cache (names fixed in phase-1 spec) -----
# Get a key at https://serper.dev — leave empty to use offline seed catalog.
SERPER_API_KEY=
CATALOG_MODE=auto                   # auto | seed | serper
SERPER_TIMEOUT_SECONDS=2.0
CACHE_TTL_SECONDS=1800
# Empty = automatic in-memory TTL cache. Docker: redis://redis:6379/0
REDIS_URL=

# ----- Phase 2: LLM routing (proposed) ---------------------------------------
# Gemini key: https://aistudio.google.com  |  Groq key: https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=groq/llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=8.0

# ----- Phase 2: Database & API (proposed) ------------------------------------
# Local: SQLite. Docker: postgresql+asyncpg://commerce:commerce@postgres:5432/commerce_ai
DATABASE_URL=sqlite+aiosqlite:///./commerce_ai.db
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Phase 4: Observability (proposed) -------------------------------------
# Leave empty to disable tracing (graceful no-op). Keys: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# NOTE: AWS credentials do NOT belong here. Use GitHub Actions secrets for CI/CD
# and AWS Secrets Manager for production runtime.

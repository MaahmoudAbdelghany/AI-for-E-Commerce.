# AI for E-Commerce — Frontend environment template
# Copy to `frontend/.env.local` for local overrides (never commit .env.local).
# Server-side Route Handler upstream target (resolved at request runtime):
BACKEND_API_URL=http://127.0.0.1:8000

# Optional server-side proxy timeout in milliseconds for /api/v1/* (default 12000, clamped 1000..60000):
# BACKEND_PROXY_TIMEOUT_MS=12000

# Forward validated X-Forwarded-For client IPs ONLY when Next.js runs behind a trusted reverse proxy / ALB:
TRUST_PROXY_HEADERS=false

# Optional browser API base override (leave unset to use same-origin /api/v1/* & /api/health proxies).
# NEXT_PUBLIC_* values are exposed to the browser: never put secrets here.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
